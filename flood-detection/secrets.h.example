#pragma once

// ============================================================
// secrets.h.example — COPY this file to secrets.h and fill in
// real values. secrets.h is gitignored so credentials never
// land in the team repo.
// ============================================================

// Blynk template info (from Blynk console → your template).
// These must be #defines and must be defined before Blynk is
// included, which is why telemetry.cpp includes this first.
#define BLYNK_TEMPLATE_ID   "TMPLxxxxxxxx"
#define BLYNK_TEMPLATE_NAME "Flood Monitor"
#define BLYNK_AUTH_TOKEN    "your-device-auth-token"

#define WIFI_SSID     "your-network"
#define WIFI_PASSWORD "your-password"
